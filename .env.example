DATABASE_URL="postgresql://insurance_advisor:insurance_advisor_dev_only@localhost:5433/insurance_advisor?schema=public"

# Google Sign-In (2026-09-11). GOOGLE_CLIENT_ID is used server-side to verify
# the ID token's audience (app/api/auth/google/route.ts); no client secret
# is needed for this flow. NEXT_PUBLIC_GOOGLE_CLIENT_ID is the same value,
# exposed to the browser so it can initialize Google Identity Services — must
# carry the NEXT_PUBLIC_ prefix or Next.js won't bundle it client-side. The
# OAuth Client ID's "Authorized JavaScript origins" (Google Cloud Console)
# must list every origin this app is actually served from — see
# docs/DECISIONS.md.
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# LLM plain-language explanations (PRD §29, 2026-09-11).
ANTHROPIC_API_KEY=""
